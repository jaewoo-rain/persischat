<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Page</title>
    <!-- 부트스트랩 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <div class="container mt-5">
        <h1 class="text-center mb-4">관리자 페이지</h1>

        <!-- 사용자 목록 -->
        <h2>사용자 목록</h2>
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>이름</th>
                    <th>삭제</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user=> { %>
                    <tr>
                        <td>
                            <%= user.id %>
                        </td>
                        <td>
                            <%= user.name %>
                        </td>
                        <td><button class="btn btn-danger btn-sm" onclick="deleteUser('<%= user._id %>')">삭제</button>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>

        <!-- 사용자 목록 페이지네이션 -->
        <nav aria-label="User Page navigation">
            <ul class="pagination justify-content-center">
                <% if (currentUserPage> 1) { %>
                    <li class="page-item">
                        <a class="page-link"
                            href="/admin?userPage=<%= currentUserPage - 1 %>&roomPage=<%= currentRoomPage %>">이전</a>
                    </li>
                    <% } %>
                        <% for (let i=1; i <=totalUserPages; i++) { %>
                            <li class="page-item <%= i === currentUserPage ? 'active' : '' %>">
                                <a class="page-link" href="/admin?userPage=<%= i %>&roomPage=<%= currentRoomPage %>">
                                    <%= i %>
                                </a>
                            </li>
                            <% } %>
                                <% if (currentUserPage < totalUserPages) { %>
                                    <li class="page-item">
                                        <a class="page-link"
                                            href="/admin?userPage=<%= currentUserPage + 1 %>&roomPage=<%= currentRoomPage %>">다음</a>
                                    </li>
                                    <% } %>
            </ul>
        </nav>

        <!-- 채팅방 목록 -->
        <h2 class="mt-4">채팅룸 목록</h2>
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>채팅룸 ID</th>
                    <th>생성자</th>
                    <th>참여자 목록</th>
                    <th>전체 데이터 보기</th>
                    <th>삭제</th>
                </tr>
            </thead>
            <tbody>
                <% rooms.forEach(room=> { %>
                    <tr>
                        <td>
                            <%= room._id %>
                        </td>
                        <td>
                            <%= room.creatUserID %>
                        </td>
                        <td>
                            <%= room.userID.join(', ') %></td>
                        <td><a class="btn btn-primary btn-sm" href="/admin/room/<%= room._id %>">보기</a></td>
                        <td><button class="btn btn-danger btn-sm" onclick="deleteRoom(' <%=room._id %>')">삭제</button>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>

        <!-- 채팅방 목록 페이지네이션 -->
        <nav aria-label="Room Page navigation">
            <ul class="pagination justify-content-center">
                <% if (currentRoomPage> 1) { %>
                    <li class="page-item">
                        <a class="page-link"
                            href="/admin?userPage=<%= currentUserPage %>&roomPage=<%= currentRoomPage - 1 %>">이전</a>
                    </li>
                    <% } %>
                        <% for (let i=1; i <=totalRoomPages; i++) { %>
                            <li class="page-item <%= i === currentRoomPage ? 'active' : '' %>">
                                <a class="page-link" href="/admin?userPage=<%= currentUserPage %>&roomPage=<%= i %>">
                                    <%= i %>
                                </a>
                            </li>
                            <% } %>
                                <% if (currentRoomPage < totalRoomPages) { %>
                                    <li class="page-item">
                                        <a class="page-link"
                                            href="/admin?userPage=<%= currentUserPage %>&roomPage=<%= currentRoomPage + 1 %>">다음</a>
                                    </li>
                                    <% } %>
            </ul>
        </nav>


        <!-- 채팅방 추가 -->
        <h2 class="mt-4">채팅방 추가</h2>
        <form id="addRoomForm" class="row g-3">
            <div class="col-auto">
                <label for="creatUserID" class="visually-hidden">채팅방 생성자 ID:</label>
                <input type="text" class="form-control" id="creatUserID" name="creatUserID" placeholder="채팅방 생성자 ID"
                    required>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-success">추가</button>
            </div>
        </form>

        <!-- 사용자 추가 -->
        <h2 class="mt-4">사용자 추가</h2>
        <form id="addUserForm" class="row g-3">
            <div class="col-md-4">
                <label for="id" class="form-label">사용자 ID</label>
                <input type="text" class="form-control" id="id" name="id" placeholder="사용자 ID" required>
            </div>
            <div class="col-md-4">
                <label for="name" class="form-label">이름</label>
                <input type="text" class="form-control" id="name" name="name" placeholder="이름" required>
            </div>
            <div class="col-md-4">
                <label for="password" class="form-label">비밀번호</label>
                <input type="password" class="form-control" id="password" name="password" placeholder="비밀번호" required>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-success mt-3">추가</button>
            </div>
        </form>
    </div>

    <!-- 부트스트랩 JS 및 Popper.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // 사용자 추가 요청
        document.getElementById('addUserForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const id = document.getElementById('id').value;
            const name = document.getElementById('name').value;
            const password = document.getElementById('password').value;
            fetch('/admin/user', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ id, name, password }),
            }).then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert('사용자가 추가되었습니다.');
                        location.reload(); // 페이지 새로고침
                    } else {
                        alert('사용자 추가 실패: ' + data.message);
                    }
                });
        });

        // 채팅방 추가 요청
        document.getElementById('addRoomForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const creatUserID = document.getElementById('creatUserID').value;
            fetch('/admin/room', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ creatUserID }),
            }).then(res => res.json())
                .then(data => {
                    if (data.success) {
                        alert('채팅방이 추가되었습니다.');
                        location.reload(); // 페이지 새로고침
                    } else {
                        alert('채팅방 추가 실패');
                    }
                });
        });

        // 사용자 삭제 요청
        function deleteUser(userId) {
            if (confirm('정말 이 사용자를 삭제하시겠습니까?')) {
                fetch(`/admin/user/${userId}`, {
                    method: 'DELETE',
                }).then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            alert('사용자 삭제 완료');
                            location.reload();
                        } else {
                            alert('사용자 삭제 실패');
                        }
                    });
            }
        }

        // 채팅방 삭제 요청
        function deleteRoom(roomId) {
            if (confirm('정말 이 채팅방을 삭제하시겠습니까?')) {
                fetch(`/admin/room/${roomId}`, {
                    method: 'DELETE',
                }).then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            alert('채팅방 삭제 완료');
                            location.reload();
                        } else {
                            alert('채팅방 삭제 실패');
                        }
                    });
            }
        }
    </script>
</body>

</html>